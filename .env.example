# Backend API
# Local dev defaults to 3039. Production on gocinema currently uses PORT=3000 behind Caddy.
HOST=127.0.0.1
PORT=3039

# 9router data dir. Defaults to ~/.9router
NINE_ROUTER_DIR=/Users/you/.9router

# Manager SQLite DB. Defaults to ~/.local/state/9router-key-manager/manager.sqlite
KEY_MANAGER_DB=/Users/you/.local/state/9router-key-manager/manager.sqlite

# 9router upstream API. Production uses 127.0.0.1:20128.
NINE_ROUTER_UPSTREAM=http://127.0.0.1:20128

# Public image creator / image proxy.
# Production uses image proxy config: upstreamBaseUrl=https://shopapikey.com/v1,
# authMode=server-key, modelOverride=cx/gpt-5.4-image.
# Keep this server-side; never expose/commit real keys.
IMAGE_PROXY_API_KEY=

# Watcher
WATCH_INTERVAL_MS=60000
# Hard-disable only when explicitly true. Default false.
HARD_DISABLE=false
