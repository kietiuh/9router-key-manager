# Backend API
# Local dev defaults to 3039. Production on gocinema currently uses PORT=3000 behind Caddy.
HOST=127.0.0.1
PORT=3039
ADMIN_PASSWORD=dev-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# 9router data dir. Defaults to ~/.9router
NINE_ROUTER_DIR=/Users/you/.9router

# Manager SQLite DB. Defaults to ~/.local/state/9router-key-manager/manager.sqlite
KEY_MANAGER_DB=/Users/you/.local/state/9router-key-manager/manager.sqlite

# 9router upstream API. Production uses 127.0.0.1:20128.
NINE_ROUTER_UPSTREAM=http://127.0.0.1:20128

# Public image creator / image proxy.
# Production uses image proxy config: upstreamBaseUrl=https://shopapikey.com/v1,
# authMode=server-key, modelOverride=cx/gpt-5.4-image.
# Keep this server-side; never expose/commit real keys.
IMAGE_PROXY_API_KEY=

# Watcher
WATCH_INTERVAL_MS=60000
# Hard-disable only when explicitly true. Default false.
HARD_DISABLE=false

# Traffic limiter and upstream generation deadlines.
# TRAFFIC_MODEL_LIMITS format: model:maxConcurrent:queueLimit:legacyTimeoutMs
# TRAFFIC_UPSTREAM_TIMEOUTS format: model:normalTimeoutMs:largeContextTimeoutMs
# Keep queue timeouts shorter than upstream timeouts so queued requests fail fast
# while active GPT-5.5 responses have enough time to finish.
TRAFFIC_MODEL_LIMITS=cx/gpt-5.5:3:30:120000,v1/cx/gpt-5.5:3:30:120000,*:20:100:120000
TRAFFIC_UPSTREAM_TIMEOUTS=cx/gpt-5.5:300000:600000,v1/cx/gpt-5.5:300000:600000,*:120000:180000
TRAFFIC_QUEUE_TIMEOUT_MS=120000
TRAFFIC_LARGE_CONTEXT_QUEUE_TIMEOUT_MS=120000

# GoCinema Assistant Telegram bot.
# Create the bot with BotFather and keep this token server-side only.
TELEGRAM_BOT_TOKEN=
# Manual bot quota refresh calls this service's public key-check API. Production key-manager uses port 3000.
BOT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
BOT_POLL_TIMEOUT_SECONDS=30
BOT_REQUEST_TIMEOUT_SECONDS=15
# Proactive quota alerts are watcher-driven; this controls Telegram delivery queue scans.
BOT_ALERT_CHECK_INTERVAL_SECONDS=300
BOT_ALERT_BATCH_LIMIT=50
BOT_DEFAULT_ALERT_THRESHOLD_PERCENT=10
BOT_TIMEZONE_OFFSET_HOURS=7
